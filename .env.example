# Copy to .env.local and fill in values from your Supabase project
# (Dashboard → Project Settings → API Keys). Never commit .env.local.

# Public values (exposed to the browser – safe by design, protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public site URL used for metadata, OAuth callbacks (/auth/callback), and password recovery redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only service role key (NEVER prefix with NEXT_PUBLIC_ and NEVER commit to Git).
# Used strictly on the server for administrative tasks such as provisioning the 6 predefined admins.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Centralized AI Configuration (Configure in Supabase Edge Function Secrets — NEVER prefix with NEXT_PUBLIC_ or VITE_)
# See docs/ai-integration-setup.md for `supabase secrets set` instructions.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Six Predefined Platform Administrators (Supply privately in .env.local — NEVER commit real credentials)
# Run `npm run provision:admins` to create or rotate these 6 accounts in Supabase Auth.
# LEARNIX_ADMIN_1_EMAIL=
# LEARNIX_ADMIN_1_PASSWORD=
# LEARNIX_ADMIN_1_NAME=
# LEARNIX_ADMIN_2_EMAIL=
# LEARNIX_ADMIN_2_PASSWORD=
# LEARNIX_ADMIN_2_NAME=
# LEARNIX_ADMIN_3_EMAIL=
# LEARNIX_ADMIN_3_PASSWORD=
# LEARNIX_ADMIN_3_NAME=
# LEARNIX_ADMIN_4_EMAIL=
# LEARNIX_ADMIN_4_PASSWORD=
# LEARNIX_ADMIN_4_NAME=
# LEARNIX_ADMIN_5_EMAIL=
# LEARNIX_ADMIN_5_PASSWORD=
# LEARNIX_ADMIN_5_NAME=
# LEARNIX_ADMIN_6_EMAIL=
# LEARNIX_ADMIN_6_PASSWORD=
# LEARNIX_ADMIN_6_NAME=
